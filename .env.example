# Database Configuration
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=hypertube
DATABASE_URL=Host=db;Database=hypertube;Username=hypertube;Password=changeme_in_production

# Backend Configuration (ASP.NET Core)
ASPNETCORE_ENVIRONMENT=Development
# JWT secret key (min 32 characters for security)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long_change_in_production
# SendGrid Email Service
# Get your free API key at: https://signup.sendgrid.com/ (100 emails/day free)
# 1. Sign up for SendGrid account
# 2. Go to Settings > API Keys
# 3. Create API Key with "Full Access" or "Mail Send" permission
# 4. Copy the API key and paste below
SENDGRID_API_KEY=you-api-key

# 42 OAuth
OAUTH_42_CLIENT_ID=your_42_client_id
OAUTH_42_CLIENT_SECRET=your_42_client_secret

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# External APIs 
# OMDb API for movie metadata
OMDB_API_KEY=your_omdb_api_key

# OpenSubtitles API for subtitles
OPENSUBTITLES_API_KEY=your_opensubtitles_api_key

# Enable Swagger in production 
ENABLE_SWAGGER_IN_PRODUCTION=false

# Log level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information
